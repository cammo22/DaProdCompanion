# Copia questo file in ".env" nella stessa cartella. ".env" e' gitignored: contiene valori
# specifici della tua macchina (nome del bot, percorsi, porte) e non va mai committato.

# Nome del companion. Se lasciato vuoto, brain_service lo chiede interattivamente al primo
# avvio (first-run setup) e scrive il valore scelto qui automaticamente.
BOT_NAME=

# Cartella dedicata del companion: database, log, memorie, screenshot, volti, file del grafo.
# Se lasciato vuoto viene derivata come %USERPROFILE%\Desktop\<BOT_NAME>
SANDBOX_ROOT=

# --- Ollama (Fase 1) ---
OLLAMA_HOST=http://127.0.0.1:11434
BRAIN_MODEL_TAG=gemma4:e4b-it-qat
BRAIN_MODEL_NUM_CTX=32768
VISION_MODEL_TAG=gemma4:e4b-it-qat
EMBEDDING_MODEL_TAG=nomic-embed-text

# --- Dreaming e iniziativa proattiva (usati dalla Fase 5 in poi) ---
DREAMING_INTERVAL_CRON=0 4 * * *
PROACTIVE_TICK_INTERVAL_SECONDS=300

# --- Webcam (usati dalla Fase 4) ---
WEBCAM_DEVICE_INDEX=0
FACE_MODEL_NAME=buffalo_s
FORCE_CPU_INSIGHTFACE=true

# --- TTS (Fase 3) ---
FORCE_CPU_KOKORO=true
# Voci italiane disponibili in Kokoro-82M: if_sara (femminile), im_nicola (maschile).
TTS_VOICE_ID=if_sara
# 1.0 = velocita' naturale di Kokoro. Alzata leggermente su richiesta dell'utente.
TTS_SPEED=1.15

# --- STT (Fase Voce) ---
# Indice del dispositivo microfono da usare (vedi menu Impostazioni). Vuoto =
# dispositivo di ingresso predefinito di sistema.
MIC_DEVICE_INDEX=

# --- Porte dei servizi locali (bind solo su 127.0.0.1, mai esposte in rete) ---
BRAIN_HTTP_PORT=8770
WEBCAM_HTTP_PORT=8771
TTS_HTTP_PORT=8772
STT_HTTP_PORT=8773

# --- Logging ---
LOG_LEVEL=INFO
