{
  "name": "daprodcompanion-app",
  "version": "0.0.1",
  "private": true,
  "description": "Avatar desktop Electron del companion (overlay + chat)",
  "main": "out/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "force-graph": "^1.51.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "com.daprod.companion",
    "productName": "DaProdCompanion",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "src/renderer/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "out/main/index.js"
    },
    "win": {
      "target": "portable",
      "icon": "resources/icons/tray-icon.ico"
    }
  }
}
